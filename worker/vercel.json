{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "djb-ai-worker",
  "builds": [{ "src": "api/index.js", "use": "@vercel/node" }],
  "routes": [
    { "src": "/health", "dest": "/api/index.js" },
    { "src": "/task", "dest": "/api/index.js" },
    { "src": "/sync", "dest": "/api/index.js" }
  ]
}
